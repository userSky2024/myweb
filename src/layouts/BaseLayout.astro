---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '微光集 · 关于代码与生活的笔记' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <script is:inline>
    try {
      var t = localStorage.getItem('blog-theme');
      if (t) document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  </script>
</head>
<body>

<div class="progress" id="progress"></div>
<div class="glow" id="glow"></div>
<div class="veil"><span>微光集</span></div>

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href={`${base}/`} class="brand"><span class="dot"></span>微光集</a>
    <nav class="nav-links">
      <a href={`${base}/#posts`}>文章</a>
      <a href={`${base}/#notes`}>笔记</a>
      <a href={`${base}/#about`}>关于</a>
      <a href={`${base}/#about`}>订阅</a>
    </nav>
    <button class="icon-btn" id="themeBtn" aria-label="切换主题">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.2"/>
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/>
      </svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer>
  <div class="foot-inner">
    <div class="foot-brand">
      <strong>微光集 · Light Notes</strong>
      © 2026 LYH · 用 Astro、CSS 和一点点耐心写成
    </div>
    <div class="socials">
      <a href="https://github.com/userSky2024" target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a>
      <a href={`${base}/rss.xml`} aria-label="RSS"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 11a8 8 0 0 1 8 8"/><path d="M5 5a14 14 0 0 1 14 14"/><circle cx="5.5" cy="18.5" r="1.4" fill="currentColor" stroke="none"/></svg></a>
    </div>
  </div>
</footer>

<button class="to-top" id="toTop" aria-label="回到顶部">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
</button>

<script>
  import '../scripts/main.js';
</script>

</body>
</html>
